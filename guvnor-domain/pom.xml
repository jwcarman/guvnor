<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jwcarman.guvnor</groupId>
    <artifactId>guvnor-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>guvnor-domain</artifactId>
  <name>Guvnor :: Domain</name>
  <description>The billing support desk. Every lesson shares it and none of them change it.</description>

  <dependencies>
    <!-- The desk itself is plain Java: no Spring, no Boot, and deliberately nothing from Loch or
         Nessy. This dependency is for DomainConfiguration alone, which assembles the services for
         an application that wants them. Everything under billing, correspondence and disputes
         compiles without it. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>

    <!-- The desk has a front, and it is the same front in every lesson, so it lives here with
         everything else that does not change. Spring MVC only; no Boot, and still nothing from
         Loch or Nessy. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-webmvc</artifactId>
    </dependency>

    <!-- Annotations only: metadata on Money saying how it crosses a wire. No Jackson runtime
         here, and the same coordinates serve Jackson 2 and 3. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>

    <!-- UUIDv7: time-ordered, so identifiers sort the way events happened. -->
    <dependency>
      <groupId>com.fasterxml.uuid</groupId>
      <artifactId>java-uuid-generator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
